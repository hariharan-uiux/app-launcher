{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppLauncherCatalog",
  "description": "Schema definition for App Launcher remote and local catalog manifests",
  "type": "object",
  "required": ["version", "updatedAt", "categories", "apps"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "category", "version", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "category": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "version": { "type": "string" },
          "installedVersion": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["not_installed", "installed", "update_available"]
          },
          "author": { "type": "string" },
          "size": { "type": "string" },
          "homepage": { "type": "string" },
          "github": { "type": "string" },
          "releaseNotes": { "type": "string" },
          "releaseUrl": { "type": "string" },
          "installTargets": {
            "type": "object",
            "properties": {
              "linux": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "command": { "type": "string" },
                  "checkInstalled": { "type": "string" },
                  "downloadUrl": { "type": "string" }
                }
              },
              "windows": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "command": { "type": "string" },
                  "checkInstalled": { "type": "string" },
                  "downloadUrl": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
